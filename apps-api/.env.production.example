# Render / production — ne jamais committer les vraies valeurs.
NODE_ENV=production
PORT=3001
FRONTEND_URL=https://mon-pokemon-spirituel.netlify.app
WEB_ORIGIN=https://mon-pokemon-spirituel.netlify.app
SESSION_SECRET=REMPLACEZ_PAR_UN_SECRET_ALEATOIRE_D_AU_MOINS_32_CARACTERES

# Génération des livrables. Laissez false pendant le premier déploiement du correctif.
GENERATION_ENABLED=false
GENERATION_JOB_TIMEOUT_MS=180000
GENERATION_STALE_MINUTES=10

# Neon (utilisez l'URL pooled fournie par Neon)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=5
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000

# Cloudflare R2 — bucket privé de production, juridiction UE
STORAGE_DRIVER=r2
R2_ENDPOINT=https://ACCOUNT_ID.eu.r2.cloudflarestorage.com
R2_REGION=auto
R2_BUCKET_NAME=mon-pokemon-spirituel-prod
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REQUEST_TIMEOUT_MS=45000

# Google OAuth — callback proxifié par Netlify pour garantir la session sur Safari/iOS
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://mon-pokemon-spirituel.netlify.app/api/v1/auth/google/callback
# Facultatif : définir select_account uniquement si le choix du compte doit être forcé.
GOOGLE_PROMPT=
