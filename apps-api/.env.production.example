# Koyeb / production — ne jamais committer les vraies valeurs.
NODE_ENV=production
PORT=3001
FRONTEND_URL=https://VOTRE-SITE.netlify.app
WEB_ORIGIN=https://VOTRE-SITE.netlify.app
SESSION_SECRET=REMPLACEZ_PAR_UN_SECRET_ALEATOIRE_D_AU_MOINS_32_CARACTERES

# Neon (utilisez l'URL pooled fournie par Neon)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=5
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000

# Cloudflare R2 — bucket privé « pokemon », juridiction UE
STORAGE_DRIVER=r2
R2_ENDPOINT=https://ACCOUNT_ID.eu.r2.cloudflarestorage.com
R2_REGION=auto
R2_BUCKET_NAME=pokemon
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Google OAuth (à configurer après l'URL Koyeb définitive)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://VOTRE-API.koyeb.app/api/v1/auth/google/callback
